# ============================================
# Soul Canvas local environment
# ============================================

# Vite 会把 VITE_ 变量打包到浏览器端。
# 生产环境不要把需要保密的服务端密钥放在 VITE_ 变量中。

# ============================================
# AI image generation
# ============================================

# Kie.ai API Key（本地开发必填，生产建议走 Worker/API 代理）
VITE_KIE_API_KEY=your_kie_api_key

# 可选值：gpt-image-2（默认）| edit | nano-banana-2
# gpt-image-2 是 GPT 最新生图模型，不配置时默认使用
# VITE_KIE_IMAGE_API_VARIANT=gpt-image-2

# 可选：覆盖默认模型。未配置时由 variant 自动选择。
# VITE_KIE_IMAGE_MODEL=

# OpenRouter API Key（fallback，本地开发使用；生产建议走 Worker/API 代理）
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# OpenRouter 图像模型（可选）
VITE_OPENROUTER_IMAGE_MODEL=google/gemini-2.0-flash-exp

# API 代理 URL（可选，使用 workers/ 里的 Cloudflare Worker 时配置）
# VITE_API_PROXY_URL=http://localhost:8787

# ============================================
# Image upload
# ============================================

# Kie 图片编辑需要先把草图上传成可访问 URL。
# 这些 VITE_ S3 凭证只适合本地开发或受控 demo；生产环境请改用服务端签名上传。
VITE_S3_REGION=your_region
VITE_S3_BUCKET=your_bucket
VITE_S3_ACCESS_KEY_ID=your_access_key
VITE_S3_SECRET_ACCESS_KEY=your_secret_key

# 可选：兼容 Cloudflare R2、MinIO 等 S3 服务
# VITE_S3_ENDPOINT=
# VITE_S3_URL=

# ============================================
# Auth and database
# ============================================

# Clerk（启用登录能力时配置）
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Neon 数据库连接字符串（前端功能使用）
VITE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Drizzle CLI 使用的数据库连接字符串
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
